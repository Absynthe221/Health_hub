{
  "name": "health-hub-ecg",
  "version": "1.0.0",
  "description": "ECG Learning Platform - A comprehensive online learning platform for healthcare learners",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "ci": "npm run lint && npm run test && npm run test:e2e",
    "assign-modules": "node scripts/user-module-assignment.js",
    "setup-ecg": "node scripts/setupECG.js",
    "optimize-ecg": "node scripts/optimizedECGPipeline.js",
    "cursor-ecg": "node scripts/cursor-ecg-pipeline-cjs.js",
    "cursor-ecg-full": "node scripts/cursor-ecg-full-pipeline.js",
    "cursor-ecg-audio": "node scripts/cursor-ecg-full-pipeline-audio-duration.js",
    "cursor-ecg-images": "node scripts/cursor-ecg-full-pipeline-images.js",
    "cursor-ecg-ultimate": "node scripts/cursor-ecg-ultimate-pipeline.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:verify": "node scripts/verify-database.js",
    "db:setup": "./scripts/setup-database.sh",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inventory": "node scripts/module-inventory.js",
    "validate": "node scripts/data-validator.js",
    "test-pipeline": "node scripts/test-suite.js",
    "test-all": "npm run inventory && npm run validate && npm run test-pipeline",
    "deploy:docker": "docker build -t health-hub-ecg .",
    "deploy:vercel": "vercel --prod",
    "health": "curl -f http://localhost:3001/api/health || exit 1",
    "process:modules": "python3 scripts/pipeline/pptx_to_module.py && python3 scripts/pipeline/segment_videos.py",
    "process:pptx": "python3 scripts/pipeline/pptx_to_module.py",
    "process:segments": "python3 scripts/pipeline/segment_videos.py",
    "process:ai": "python3 scripts/pipeline/ai_integration.py",
    "process:full": "python3 scripts/pipeline/pptx_to_module.py && python3 scripts/pipeline/segment_videos.py && python3 scripts/pipeline/ai_integration.py",
    "ai:enhanced": "python3 scripts/pipeline/ai_enhanced_pipeline.py",
    "pipeline:run": "node scripts/complete_pipeline.js",
    "pipeline:dry-run": "node scripts/complete_pipeline.js --dry-run",
    "pipeline:skip-ai": "node scripts/complete_pipeline.js --skip-ai",
    "pipeline:full": "node scripts/complete_pipeline.js --force",
    "production-ready": "npm run test-all && npm run build && npm run health",
    "setup:api-keys": "node scripts/setup-api-keys.js",
    "deploy:production": "node scripts/deploy-production.js",
    "deploy:full": "npm run setup:api-keys && npm run deploy:production",
    "health": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@prisma/client": "^5.9.1",
    "autoprefixer": "^10.4.17",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cli-progress": "^3.12.0",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "formidable": "^3.5.4",
    "fs-extra": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "mongoose": "^8.18.3",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "next": "14.1.0",
    "next-auth": "^4.24.11",
    "node-fetch": "^3.3.2",
    "openai": "^5.23.1",
    "p-queue": "^8.1.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.149",
    "postcss": "^8.4.35",
    "pptx-parser": "^1.1.7-beta.9",
    "pptx2json": "^0.0.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^10.1.0",
    "react-player": "^3.3.3",
    "recharts": "^3.2.1",
    "say": "^0.16.0",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.1",
    "video-react": "^0.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "prisma": "^5.9.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
